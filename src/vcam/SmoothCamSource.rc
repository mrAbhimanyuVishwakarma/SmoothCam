#include <winres.h>
#include "Version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION SMOOTHCAM_VERSION_RC
 PRODUCTVERSION SMOOTHCAM_VERSION_RC
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "SmoothCam contributors"
            VALUE "FileDescription", "SmoothCam virtual camera media source"
            VALUE "FileVersion", SMOOTHCAM_VERSION_STRING
            VALUE "InternalName", "SmoothCamSource"
            VALUE "LegalCopyright", "Copyright (c) 2026 SmoothCam contributors. MIT License."
            VALUE "OriginalFilename", "SmoothCamSource.dll"
            VALUE "ProductName", "SmoothCam"
            VALUE "ProductVersion", SMOOTHCAM_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
